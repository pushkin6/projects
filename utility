# ISO mount one-liner
for iso in $(find / -name "*.iso" 2>/dev/null); do echo "Found: $iso"; sudo mkdir -p /mnt/iso && sudo mount -o loop "$iso" /mnt/iso && echo "Mounted: $iso" && break; done

# --- CREATING ARCHIVES ---
tar -cvf archive.tar /path/to/folder       
tar -czvf archive.tar.gz /path/to/folder    
tar -cjvf archive.tar.bz2 /path/to/folder  
tar -cJvf archive.tar.xz /path/to/folder   

# Extract
tar -xvf archive.tar                        
tar -xzvf archive.tar.gz                  
tar -xjvf archive.tar.bz2                 
tar -xJvf archive.tar.xz                   
tar -xvf archive.tar -C /target/directory  

# Inspect without extract
tar -tvf archive.tar                        
tar -tzvf archive.tar.gz                   

# Excluding Files
tar -czvf archive.tar.gz folder/ --exclude='*.log'   
tar -czvf archive.tar.gz folder/ --exclude-vcs        

