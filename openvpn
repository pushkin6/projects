sudo apt update && sudo apt install openvpn easy-rsa -y

make-cadir ~/openvpn-ca
cd ~/openvpn-ca
./easyrsa init-pki
./easyrsa build-ca nopass
./easyrsa gen-req server nopass
./easyrsa sign-req server server
./easyrsa gen-dh
openvpn --genkey secret ta.key

cd ~/openvpn-ca
./easyrsa gen-req ubuntu-client nopass
./easyrsa sign-req client ubuntu-client

sudo mkdir -p /etc/openvpn/server
sudo cp ~/openvpn-ca/pki/ca.crt              /etc/openvpn/server/
sudo cp ~/openvpn-ca/pki/issued/server.crt   /etc/openvpn/server/
sudo cp ~/openvpn-ca/pki/private/server.key  /etc/openvpn/server/
sudo cp ~/openvpn-ca/pki/dh.pem              /etc/openvpn/server/
sudo cp ~/openvpn-ca/ta.key                  /etc/openvpn/server/

# SERVER CONFIG ==================================
port 1194
proto udp
dev tun

ca   /etc/openvpn/server/ca.crt
cert /etc/openvpn/server/server.crt
key  /etc/openvpn/server/server.key
dh   /etc/openvpn/server/dh.pem
tls-auth /etc/openvpn/server/ta.key 0

server 10.8.0.0 255.255.255.0

push "route 10.10.20.0 255.255.255.0"
push "route 10.10.30.0 255.255.255.0"
push "route 192.168.10.0 255.255.255.0"

client-to-client
disable-dco

cipher AES-256-GCM
auth SHA256
keepalive 10 120
persist-tun

user nobody
group nogroup

status /var/log/openvpn-status.log
log-append /var/log/openvpn.log
verb 3

# Enable forwarding and setting up iptables rules
echo "net.ipv4.ip_forward=1" | sudo tee -a /etc/sysctl.conf
sudo sysctl -p

sudo iptables -A FORWARD -i tun0 -j ACCEPT
sudo iptables -A FORWARD -o tun0 -j ACCEPT
sudo iptables -A FORWARD -m state --state RELATED,ESTABLISHED -j ACCEPT
sudo iptables -A INPUT -i tun0 -j ACCEPT
sudo iptables -t nat -A POSTROUTING -s 10.8.0.0/24 -o eth0 -j MASQUERADE

sudo systemctl start openvpn-server@server
sudo systemctl enable openvpn-server@server
sudo systemctl status openvpn-server@server

# Building client config

cat > ~/ubuntu-client.ovpn << EOF
client
dev tun
proto udp
remote 192.168.10.10 1194
resolv-retry infinite
nobind
route-nopull
route 10.8.0.0 255.255.255.0
route 192.168.10.0 255.255.255.0
route 10.10.30.0 255.255.255.0
cipher AES-256-GCM
auth SHA256
key-direction 1
verb 3

<ca>
$(cat ~/openvpn-ca/pki/ca.crt)
</ca>
<cert>
$(openssl x509 -in ~/openvpn-ca/pki/issued/ubuntu-client.crt)
</cert>
<key>
$(cat ~/openvpn-ca/pki/private/ubuntu-client.key)
</key>
<tls-auth>
$(cat ~/openvpn-ca/ta.key)
</tls-auth>
EOF

#Installing on client i used ubuntu for this instance

sudo apt install openvpn -y
sudo cp ~/ubuntu-client.ovpn /etc/openvpn/client/ubuntu-client.conf
sudo systemctl start openvpn-client@ubuntu-client
sudo systemctl enable openvpn-client@ubuntu-client
